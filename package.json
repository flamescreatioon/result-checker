{
  "name": "result-checker",
  "version": "1.0.0",
  "description": "Student result-checking platform built with React, Express, and PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm install --prefix client && npm run build --prefix client",
    "start": "npm run start --prefix server",
    "db:init": "npm run db:init --prefix server",
    "import:data": "npm run import:csv --prefix server",
    "test": "echo \"No root tests configured\"",
    "version:check": "node scripts/check-version.js",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\""
  },
  "keywords": [
    "student-results",
    "react",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flamescreatioon/result-checker.git"
  },
  "bugs": {
    "url": "https://github.com/flamescreatioon/result-checker/issues"
  },
  "homepage": "https://github.com/flamescreatioon/result-checker#readme",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "serverless-http": "^4.0.0"
  }
}
